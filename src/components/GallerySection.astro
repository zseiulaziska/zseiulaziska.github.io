---
import { Image, getImage, type ImageMetadata } from 'astro:assets';
import photo1 from '../assets/images/galeria/photo1.webp';
import photo4 from '../assets/images/galeria/photo4.webp';
import photo5 from '../assets/images/galeria/photo5.webp';
import photo7 from '../assets/images/galeria/photo7.webp';
import photoDx9 from '../assets/images/galeria/photo_DX9bwrsMJYv.webp';
import photoDykr from '../assets/images/galeria/photo_DYKR3bkCOFB.webp';
import photoDwl from '../assets/images/galeria/photo_DWL8SlIiJLr.webp';
import poster1 from '../assets/images/galeria/video-poster.webp';
import poster2 from '../assets/images/galeria/video2-poster.webp';
import poster3 from '../assets/images/galeria/video3-poster.webp';
import poster4 from '../assets/images/galeria/video4-poster.webp';
import poster5 from '../assets/images/galeria/video5-poster.webp';

interface GalleryBase {
  span: string;
  alt: string;
}

type GalleryItem =
  | (GalleryBase & { type: 'photo'; src: ImageMetadata })
  | (GalleryBase & { type: 'video'; src: string; poster: string });

// Plakaty wideo są tłem kafelka (max ~300 px szerokości), więc generujemy mały wariant WebP.
const posterUrl = async (src: ImageMetadata) =>
  (await getImage({ src, width: 480, format: 'webp', quality: 55 })).src;

const posters = {
  video1: await posterUrl(poster1),
  video2: await posterUrl(poster2),
  video3: await posterUrl(poster3),
  video4: await posterUrl(poster4),
  video5: await posterUrl(poster5),
};

// Kafelki mają maks. ~50vw na mobile i ~16vw na desktopie — dlatego warianty 240–720 px.
const photoWidths = [240, 360, 480, 720];
const photoSizes = '(min-width: 1024px) 16vw, 50vw';

const items: GalleryItem[] = [
  { type: 'video', src: '/wideo/video3.mp4', poster: posters.video3, span: 'col-span-2 row-span-2', alt: 'Wideo z życia szkoły' },
  { type: 'video', src: '/wideo/video4.mp4', poster: posters.video4, span: 'row-span-2', alt: 'Wideo z życia szkoły' },
  { type: 'video', src: '/wideo/video5.mp4', poster: posters.video5, span: 'row-span-2', alt: 'Wideo z życia szkoły' },
  { type: 'photo', src: photo1, span: '', alt: 'Uczniowie klas mundurowych w mundurach przed szklanym gmachem' },
  { type: 'photo', src: photo4, span: '', alt: 'Uczniowie w mundurach wojskowych i policyjnych w szeregu przed budynkiem szkoły' },
  { type: 'photo', src: photo5, span: '', alt: 'Uczniowie klas mundurowych z robotem pirotechnicznym i kombinezonem sapera' },
  { type: 'photo', src: photo7, span: '', alt: 'Uczniowie klas mundurowych z psem służbowym na lotnisku, w tle tablica przylotów' },
  { type: 'video', src: '/wideo/video.mp4', poster: posters.video1, span: '', alt: 'Wideo z życia szkoły' },
  { type: 'photo', src: photoDx9, span: '', alt: 'Grupa uczniów ZSEiU na wycieczce przed zabytkową fontanną' },
  { type: 'video', src: '/wideo/video2.mp4', poster: posters.video2, span: 'col-span-2', alt: 'Wideo z życia szkoły' },
  { type: 'photo', src: photoDykr, span: '', alt: 'Uczniowie podczas praktyk Erasmus+ na Sycylii, na pokładzie łodzi' },
  { type: 'photo', src: photoDwl, span: '', alt: 'Uczniowie w mundurach i wyposażeniu taktycznym podczas pokazu' },
];
---

<section class="reveal relative left-1/2 w-screen -translate-x-1/2 bg-white dark:bg-navy-950">
  <div class="grid w-full auto-rows-[30vw] grid-flow-dense grid-cols-2 sm:auto-rows-[24vw] lg:auto-rows-[15vw] lg:grid-cols-6">
    {
      items.map((item) =>
        item.type === 'photo' ? (
          <div class={`group relative overflow-hidden bg-slate-200 dark:bg-navy-800 ${item.span}`}>
            <Image
              src={item.src}
              alt={item.alt}
              widths={photoWidths}
              sizes={photoSizes}
              quality={65}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
            />
          </div>
        ) : (
          <div class={`group relative overflow-hidden bg-navy-950 ${item.span}`}>
            <video
              class="h-full w-full object-cover opacity-70 transition-opacity duration-300 group-hover:opacity-100"
              src={item.src}
              poster={item.poster}
              muted
              loop
              playsinline
              preload="none"
              data-gallery-video
              aria-label={item.alt}
            ></video>
            <span data-gallery-play-icon class="pointer-events-none absolute inset-0 flex items-center justify-center transition-opacity duration-300 group-hover:opacity-0" aria-hidden="true">
              <span class="flex h-14 w-14 items-center justify-center rounded-full bg-black/40 backdrop-blur-sm">
                <svg class="ml-1 h-6 w-6 text-white" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </span>
            </span>
          </div>
        )
      )
    }
  </div>
</section>

<script>
  const isTouch = window.matchMedia('(pointer: coarse)').matches;
  document.querySelectorAll<HTMLVideoElement>('[data-gallery-video]').forEach((video) => {
    const icon = video.parentElement!.querySelector<HTMLElement>('[data-gallery-play-icon]');
    const setIcon = () => {
      if (icon) icon.classList.toggle('opacity-0', !video.paused);
    };
    video.addEventListener('play', setIcon);
    video.addEventListener('pause', setIcon);
    if (isTouch) {
      video.addEventListener('click', () => {
        if (video.paused) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    } else {
      video.addEventListener('mouseenter', () => {
        video.play().catch(() => {});
      });
      video.addEventListener('mouseleave', () => {
        video.pause();
      });
    }
  });
</script>
