  'technik-informatyk': 'bg-slate-100 dark:bg-navy-700 text-blue-400 dark:text-blue-500',
  'technik-logistyk': 'bg-slate-100 dark:bg-navy-700 text-emerald-400 dark:text-emerald-500',
  'opw': 'bg-slate-100 dark:bg-navy-700 text-red-400 dark:text-red-500',
