    box-shadow: none !important;
    color: #fff !important;
    text-shadow: none !important;
  }

  html.high-contrast .school-fields a {
    color: #ffff00 !important;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
