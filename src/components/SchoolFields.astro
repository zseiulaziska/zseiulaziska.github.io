---
import schoolGroups from '../content/field/school-groups.json';

interface FieldItem {
  name: string;
  note?: string;
  slug: string;
  colSpan?: boolean;
}

interface SchoolGroup {
  name: string;
  years?: string;
  fields: FieldItem[];
}

export type Variant = 'detailed' | 'compact';

const { groups = schoolGroups, variant = 'detailed' }: { groups?: SchoolGroup[]; variant?: Variant } = Astro.props;

const renderedGroups = groups.filter(g => g.name !== "Branżowa Szkoła I stopnia - klasa wielozawodowa");
const totalFieldsCount = renderedGroups.reduce((acc, g) => acc + g.fields.length, 0);

const categoryKey: Record<string, string> = {
  "Technikum Nr 1": "Technikum",
  "Branżowa Szkoła I stopnia": "Branżowa I stopnia",
  "Branżowa Szkoła II stopnia": "Branżowa II stopnia",
  "LO dla Dorosłych": "Dla dorosłych",
};

const categoryLabels: Record<string, string> = {
  "Technikum Nr 1": "Technikum",
  "Branżowa Szkoła I stopnia": "Szkoła Branżowa I st.",
  "Branżowa Szkoła II stopnia": "Szkoła Branżowa II st.",
  "LO dla Dorosłych": "Liceum dla Dorosłych",
};

const knownPages: Record<string, string> = {
  "technik-elektryk": "/technik-elektryk",
  "technik-informatyk": "/technik-informatyk",
  "technik-logistyk": "/technik-logistyk",
  "technik-organizacji-turystyki": "/technik-organizacji-turystyki",
  "technik-stylista": "/technik-stylista",
  "technik-oze": "/technik-urzadzen-i-systemow-energetyki-odnawialnej",
  "opw": "/opw",
  "opm": "/opm",
  "lo-profil-ogolny": "/lo-dla-doroslych",
  "wielozawodowa": "/wielozawodowa"
};

const filterTabs = [
  { id: "all", label: "Wszystkie" },
  { id: "technikum", label: "Technikum" },
  { id: "branzowa-i-stopnia", label: "Branżowa I stopnia" },
  { id: "branzowa-ii-stopnia", label: "Branżowa II stopnia" },
  { id: "dla-doroslych", label: "Dla dorosłych" },
];

const groupFilterId: Record<string, string> = {
  "Technikum Nr 1": "technikum",
  "Branżowa Szkoła I stopnia": "branzowa-i-stopnia",
  "Branżowa Szkoła II stopnia": "branzowa-ii-stopnia",
  "LO dla Dorosłych": "dla-doroslych",
};

const getCompetencies = (note?: string): string[] => {
  if (!note) return [];
  return note.split('|').flatMap(part => part.split('·')).map(p => p.trim()).filter(p => p && !/^\d+$/.test(p));
};

