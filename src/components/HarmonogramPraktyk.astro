---
export interface Tura {
  id: string;
  label: string;
  dataRozpoczecia: string;
  dataZakonczenia: string;
  klasy: string[];
}

interface Props {
  rokSzkolny: string;
  p1: { label: string; tury: Tura[] };
  p2: { label: string; tury: Tura[] };
}

const { rokSzkolny, p1, p2 } = Astro.props;

function formatDate(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<div class="harmonogram">
  <div class="flex items-center gap-2 mb-6">
    <svg class="w-5 h-5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>
    <h2 class="text-xl font-bold text-slate-900 dark:text-white">Harmonogram praktyk <span class="text-emerald-600 dark:text-emerald-400">{rokSzkolny}</span></h2>
  </div>

  <div class="space-y-8">
    <section>
      <div class="flex items-center gap-3 mb-4">
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 font-bold text-sm">P1</span>
        <div>
          <h3 class="font-semibold text-slate-900 dark:text-white">{p1.label}</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">Klasy 3. &ndash; pierwsza praktyka zawodowa</p>
        </div>
      </div>

      <div class="grid gap-3">
        {p1.tury.map((tura) => (
          <div class="rounded-xl border border-slate-200 dark:border-navy-700 overflow-hidden">
            <div class="bg-emerald-50 dark:bg-emerald-900/20 px-4 py-2.5 border-b border-slate-200 dark:border-navy-700 flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center justify-center px-2 py-0.5 rounded text-xs font-bold bg-emerald-200 dark:bg-emerald-800 text-emerald-800 dark:text-emerald-200">{tura.label}</span>
                <span class="text-xs text-slate-600 dark:text-slate-400">
                  {formatDate(tura.dataRozpoczecia)} &ndash; {formatDate(tura.dataZakonczenia)}
                </span>
              </div>
              <span class="text-xs font-medium text-slate-500 dark:text-slate-400">4 tygodnie</span>
            </div>
            <div class="px-4 py-3 bg-white dark:bg-navy-800/50">
              <div class="flex flex-wrap gap-2">
                {tura.klasy.map((klasa) => (
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-medium bg-emerald-100 dark:bg-emerald-900/40 text-emerald-800 dark:text-emerald-200 border border-emerald-200 dark:border-emerald-700/50">
                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                    {klasa}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section>
      <div class="flex items-center gap-3 mb-4">
        <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 font-bold text-sm">P2</span>
        <div>
          <h3 class="font-semibold text-slate-900 dark:text-white">{p2.label}</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">Klasy 4. &ndash; druga praktyka zawodowa</p>
        </div>
      </div>

      <div class="grid gap-3">
        {p2.tury.map((tura) => (
          <div class="rounded-xl border border-slate-200 dark:border-navy-700 overflow-hidden">
            <div class="bg-blue-50 dark:bg-blue-900/20 px-4 py-2.5 border-b border-slate-200 dark:border-navy-700 flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center justify-center px-2 py-0.5 rounded text-xs font-bold bg-blue-200 dark:bg-blue-800 text-blue-800 dark:text-blue-200">{tura.label}</span>
                <span class="text-xs text-slate-600 dark:text-slate-400">
                  {formatDate(tura.dataRozpoczecia)} &ndash; {formatDate(tura.dataZakonczenia)}
                </span>
              </div>
              <span class="text-xs font-medium text-slate-500 dark:text-slate-400">4 tygodnie</span>
            </div>
            <div class="px-4 py-3 bg-white dark:bg-navy-800/50">
              <div class="flex flex-wrap gap-2">
                {tura.klasy.map((klasa) => (
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-medium bg-blue-100 dark:bg-blue-900/40 text-blue-800 dark:text-blue-200 border border-blue-200 dark:border-blue-700/50">
                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                    {klasa}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</div>
