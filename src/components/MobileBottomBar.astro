---
import { quickAccessLinks } from '../routes';
import { quickAccessIconPaths } from './quick-access-icons';

const links = quickAccessLinks();
---

<div class="mobile-bottom-bar">
  {links.map((link) => (
    <a
      href={link.href}
      target={link.external ? '_blank' : undefined}
      rel={link.external ? 'noopener noreferrer' : undefined}
      class="mobile-bottom-bar__link"
      aria-label={link.label}
    >
      <svg class="mobile-bottom-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={quickAccessIconPaths[link.id as keyof typeof quickAccessIconPaths]} />
      <span>{link.label}</span>
    </a>
  ))}
</div>
