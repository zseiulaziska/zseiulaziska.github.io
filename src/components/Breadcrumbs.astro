---
import { buildCrumbs } from '../routes';

const PATH = Astro.url.pathname;
const currentPath = PATH.replace(/\/+$/, '') || '/';
const { title } = Astro.props as { title?: string };
const origin = Astro.site ?? Astro.url.origin;
const crumbs = buildCrumbs(PATH, title);

if (crumbs.length === 0) return;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.label,
    item: new URL(crumb.href, origin).href,
  })),
};
---

<script set:html={JSON.stringify(jsonLd)} type="application/ld+json"></script>

<nav aria-label="Ścieżka nawigacyjna" class="breadcrumbs" data-pagefind-ignore>
  <ol>
    {crumbs.map((crumb) => (
      <li>
        <a
          href={crumb.href}
          aria-current={crumb.href.replace(/\/+$/, '') === currentPath ? 'page' : undefined}
        >
          {crumb.label}
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs {
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: #6b7280;
  }
  :global(.dark) .breadcrumbs {
    color: #94a3b8;
  }
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }
  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .breadcrumbs li + li::before {
    content: '/' / '';
    color: #d1d5db;
  }
  :global(.dark) .breadcrumbs li + li::before {
    color: #1e3a5f;
  }
  .breadcrumbs a {
    transition: color 0.15s ease;
  }
  .breadcrumbs a:hover {
    color: #0070b0;
    text-decoration: underline;
  }
  :global(.dark) .breadcrumbs a:hover {
    color: #7ed0ff;
  }
  .breadcrumbs a[aria-current='page'] {
    font-weight: 500;
    color: #111827;
    text-decoration: none;
  }
  :global(.dark) .breadcrumbs a[aria-current='page'] {
    color: #f1f5f9;
  }
  @media (forced-colors: active) {
    .breadcrumbs a[aria-current='page'] {
      text-decoration: underline;
    }
  }
</style>
