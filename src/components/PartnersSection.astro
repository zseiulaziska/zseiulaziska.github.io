---
const partners = [
  { name: 'Polska Grupa Górnicza', logo: '/images/partnerzy/logo_pgg.png', width: 621, height: 256, type: 'Pracodawca' },
  { name: 'TAURON', logo: '/images/partnerzy/tauron.webp', width: 601, height: 152, type: 'Pracodawca' },
  { name: 'bekuplast S.A.', logo: '/images/partnerzy/bekuplast.svg', width: 183, height: 48, type: 'Pracodawca' },
  { name: 'Wojskowe Centrum Rekrutacji', logo: '/images/partnerzy/wcr.jpg', width: 1080, height: 1080, type: 'Instytucja' },
  { name: 'Policja Śląska', logo: '/images/partnerzy/Policja_Slaska.png', width: 250, height: 249, type: 'Instytucja' },
  { name: '13 Śląska Brygada Obrony Terytorialnej', logo: '/images/partnerzy/odz13_.png', width: 3096, height: 2995, type: 'Instytucja' },
];
---

<section id="partnerzy" class="reveal relative overflow-hidden border-y border-white/5 bg-navy-950 py-24 lg:py-32">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -top-32 left-1/4 h-72 w-72 rounded-full bg-primary-500/15 blur-3xl"></div>
    <div class="absolute -bottom-32 right-1/4 h-72 w-72 rounded-full bg-accent-500/10 blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-16 max-w-2xl space-y-4 text-center">
      <h2 class="text-xs font-bold uppercase tracking-widest text-primary-300">Nasi Partnerzy</h2>
      <p class="text-4xl font-black tracking-tight text-balance text-white sm:text-5xl">
        Partnerzy i pracodawcy
      </p>
      <p class="text-lg text-slate-400">
        Nasi uczniowie zdobywają doświadczenie u najlepszych pracodawców regionu
      </p>
    </div>

    <div class="partners-viewport">
      <div class="partners-track">
        <ul class="partners-group" role="list">
          {partners.map((partner) => (
            <li class="group flex h-32 shrink-0 items-center justify-center rounded-2xl bg-white px-12 shadow-lg shadow-black/20 hover:scale-105 transition-transform duration-300">
              <img
                src={partner.logo}
                alt={partner.name}
                width={partner.width}
                height={partner.height}
                loading="lazy"
                decoding="async"
                class="max-h-16 w-auto object-contain mix-blend-multiply grayscale transition duration-300 group-hover:grayscale-0"
              />
            </li>
          ))}
        </ul>
        <ul class="partners-group" aria-hidden="true">
          {partners.map((partner) => (
            <li class="group flex h-32 shrink-0 items-center justify-center rounded-2xl bg-white px-12 shadow-lg shadow-black/20 hover:scale-105 transition-transform duration-300">
              <img
                src={partner.logo}
                alt=""
                width={partner.width}
                height={partner.height}
                loading="lazy"
                decoding="async"
                class="max-h-16 w-auto object-contain mix-blend-multiply grayscale transition duration-300 group-hover:grayscale-0"
              />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .partners-viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .partners-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: partners-scroll 45s linear infinite;
  }

  .partners-group {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-right: 2rem;
  }

  .partners-viewport:hover .partners-track {
    animation-play-state: paused;
  }

  @keyframes partners-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .partners-track {
      width: 100%;
      flex-wrap: wrap;
      animation: none;
    }

    .partners-group {
      flex-wrap: wrap;
      justify-content: center;
    }

    .partners-group[aria-hidden='true'] {
      display: none;
    }
  }
</style>
