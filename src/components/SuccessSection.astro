---
const stats = [
  { value: '580+', label: 'Uczniów' },
  { value: '15+', label: 'lat realizacji projektów europejskich' },
  { value: '10+', label: 'Nowoczesne laboratoria i pracownie' },
  { value: '40+', label: 'Partnerów biznesowych i instytucji' },
  { value: '100%', label: 'Uczniów odbywa praktyki u pracodawców' },
  { value: '80+', label: 'Lat tradycji' },
];
---


<section class="reveal bg-slate-50 dark:bg-navy-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8">
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
      {stats.map((stat) => (
        <div class="rounded-xl bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-600 p-5 text-center hover:shadow-md transition-shadow">
          <p class="text-3xl font-extrabold text-primary-600 dark:text-primary-400">{stat.value}</p>
          <p class="mt-1 text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
