---
import type { DownloadItem } from '../utils/downloads-catalog';

interface Props {
  item: DownloadItem;
}

const { item } = Astro.props;

const formatStyles: Record<string, string> = {
  PDF: 'bg-red-100 dark:bg-red-950/60 text-red-700 dark:text-red-300',
  DOC: 'bg-blue-100 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300',
  DOCX: 'bg-blue-100 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300',
  XLS: 'bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300',
  XLSX: 'bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300',
  PPT: 'bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300',
  PPTX: 'bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300',
  ZIP: 'bg-purple-100 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300',
};

const tileStyle =
  formatStyles[item.format] ??
  'bg-cyan-100 dark:bg-cyan-950/60 text-cyan-700 dark:text-cyan-300';

const displayDate = item.updatedDate ?? item.pubDate;
const formattedDate = new Intl.DateTimeFormat('pl-PL', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
}).format(displayDate);
---

<article
  id={item.id}
  data-pagefind-title={item.title}
  data-pagefind-filter={`format:${item.format}`}
  class="group rounded-xl bg-white dark:bg-navy-800/70 border border-slate-200 dark:border-navy-700 p-5 shadow-sm hover:shadow-md hover:border-primary-300 dark:hover:border-primary-700 transition-all duration-300 flex flex-col gap-4 min-w-0 scroll-mt-24"
>
  {item.featured && (
    <p class="inline-flex items-center gap-1.5 self-start px-2.5 py-1 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 text-xs font-bold uppercase tracking-wide">
      <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5" aria-hidden="true">
        <path d="M12 2l2.9 6.2 6.8.9-4.9 4.7 1.2 6.8L12 17.4 6 20.6l1.2-6.8L2.3 9.1l6.8-.9z"></path>
      </svg>
      Polecane
    </p>
  )}

  <div class="flex items-start gap-4 min-w-0">
    <span
      aria-hidden="true"
      class={`shrink-0 w-12 h-12 rounded-xl flex flex-col items-center justify-center ${tileStyle}`}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
      </svg>
      <span class="text-[9px] font-bold leading-none mt-0.5">{item.format}</span>
    </span>

    <div class="min-w-0">
      <span class="sr-only" data-pagefind-filter="kategoria">{item.categoryLabel}</span>
      <h3 class="font-bold text-slate-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors wrap-break-word">
        {item.title}
      </h3>
      <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mt-1 wrap-break-word">
        {item.description}
      </p>
    </div>
  </div>

  <p class="text-sm text-slate-500 dark:text-slate-400 flex flex-wrap items-center gap-x-2 gap-y-1">
    <span class="font-semibold">{item.categoryLabel}</span>
    <span aria-hidden="true">·</span>
    <span>{item.format}</span>
    <span aria-hidden="true">·</span>
    <span>{item.fileSize}</span>
    <span aria-hidden="true">·</span>
    <time datetime={displayDate.toISOString().slice(0, 10)}>
      {item.updatedDate ? 'aktualizacja' : 'opublikowano'} {formattedDate}
    </time>
  </p>

  <a
    href={item.href}
    download={item.external ? undefined : item.downloadName}
    target={item.external ? '_blank' : undefined}
    rel={item.external ? 'noopener noreferrer' : undefined}
    class="inline-flex items-center justify-center gap-2 self-start px-5 py-2.5 rounded-xl bg-accent-600 text-white text-sm font-semibold hover:bg-accent-700 transition-colors shadow-sm"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true">
      <path d="M12 3v12m0 0 4-4m-4 4-4-4"></path>
      <path d="M4 17v3h16v-3"></path>
    </svg>
    Pobierz
    {item.external ? (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4" aria-hidden="true">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
      <span class="sr-only">— {item.title}, {item.format}, otwiera się w nowej karcie</span>
    ) : (
      <span class="sr-only">— {item.title}, {item.format}, {item.fileSize}</span>
    )}
  </a>
</article>
