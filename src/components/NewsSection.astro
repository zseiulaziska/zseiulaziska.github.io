---
export interface Props {
  posts: readonly {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      heroImage?: string;
      imageAlt?: string;
      category?: string;
      featured?: boolean;
      featuredLabel?: string;
    };
  }[];
}

const { posts } = Astro.props;

const categoryColors: Record<string, string> = {
  Rekrutacja: 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300',
  Sukcesy: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300',
  Wydarzenia: 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300',
  Projekty: 'bg-violet-100 text-violet-700 dark:bg-violet-900/40 dark:text-violet-300',
  Sport: 'bg-rose-100 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300',
};

const featuredStyles: Record<string, string> = {
  WAŻNE: 'bg-red-600 text-white',
  REKRUTACJA: 'bg-blue-600 text-white',
  PILNE: 'bg-orange-600 text-white',
};
---

<section class="reveal py-20 lg:py-28 bg-white dark:bg-navy-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
      <h2 class="text-xs font-bold text-primary-600 uppercase tracking-widest">Wpisy z bloga</h2>
      <p class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">Aktualności</p>
      <p class="text-lg text-slate-600 dark:text-slate-300">Bądź na bieżąco z wydarzeniami w szkole</p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-2 mb-10">
      <button data-category="all" class="category-filter active px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 bg-primary-600 text-white shadow-xs">Wszystkie</button>
      {['Rekrutacja', 'Sukcesy', 'Wydarzenia', 'Projekty', 'Sport'].map((cat) => (
        <button data-category={cat} class="category-filter px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 bg-white dark:bg-navy-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-navy-700 hover:bg-slate-100 dark:hover:bg-navy-700">
          {cat}
        </button>
      ))}
    </div>

    <div class="grid md:grid-cols-3 gap-8" id="news-grid">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`}
          class="news-card group flex flex-col bg-slate-50 dark:bg-navy-800 border border-slate-200 dark:border-navy-600 rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300"
          data-category={post.data.category || ''}>
          <div class="relative w-full h-48 overflow-hidden bg-gray-200 dark:bg-navy-700">
            {post.data.heroImage ? (
              <img src={post.data.heroImage} alt={post.data.imageAlt || ''} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            ) : (
              <div class="w-full h-full flex items-center justify-center text-slate-400">
                <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" /></svg>
              </div>
            )}
            {post.data.featured && post.data.featuredLabel && (
              <span class={`absolute top-3 left-3 px-2.5 py-0.5 rounded-md text-[11px] font-bold uppercase tracking-wider ${featuredStyles[post.data.featuredLabel] || 'bg-red-600 text-white'}`}>
                {post.data.featuredLabel}
              </span>
            )}
            {post.data.category && !post.data.featured && (
              <span class={`absolute top-3 left-3 px-2.5 py-0.5 rounded-md text-[11px] font-semibold ${categoryColors[post.data.category] || 'bg-slate-100 text-slate-700'}`}>
                {post.data.category}
              </span>
            )}
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <time class="text-xs text-slate-500 dark:text-slate-400 uppercase tracking-wider">
              {post.data.pubDate ? new Date(post.data.pubDate).toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' }) : ''}
            </time>
            <h3 class="mt-3 text-lg font-bold text-slate-900 dark:text-white group-hover:text-primary-500 dark:group-hover:text-primary-300 transition-colors">
              {post.data.title}
            </h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300 leading-relaxed flex-1">
              {post.data.description}
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-primary-600 dark:text-primary-300 group/link">
              Czytaj więcej
              <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="M12 5l7 7-7 7"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="text-center mt-12">
      <a href="/blog"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary-600 text-white font-semibold hover:bg-primary-700 transition">
        Zobacz wszystkie wpisy
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/><path d="M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  (function () {
    const filters = document.querySelectorAll('.category-filter');
    const cards = document.querySelectorAll('.news-card');

    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category') || 'all';

        filters.forEach((b) => {
          b.classList.remove('active', 'bg-primary-600', 'text-white', 'shadow-xs');
          b.classList.add('bg-white', 'dark:bg-navy-800', 'text-slate-700', 'dark:text-slate-300', 'border', 'border-slate-200', 'dark:border-navy-700');
        });
        btn.classList.add('active', 'bg-primary-600', 'text-white', 'shadow-xs');
        btn.classList.remove('bg-white', 'dark:bg-navy-800', 'text-slate-700', 'dark:text-slate-300', 'border', 'border-slate-200', 'dark:border-navy-700');

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          if (cat === 'all' || cardCat === cat) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  })();
</script>
