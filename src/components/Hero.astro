---
import { Picture } from 'astro:assets';
import heroImage from '../assets/images/333_mundurowi.jpg';
---

<section class="relative w-full min-h-[85svh] flex items-center overflow-hidden bg-navy-950">
  <div class="absolute inset-0">
    <Picture
      src={heroImage}
      formats={['avif', 'webp']}
      widths={[480, 768, 960, 1200]}
      sizes="100vw"
      quality={45}
      alt="Uczniowie ZSEiU"
      class="w-full h-full object-cover"
      priority
    />
    <div class="absolute inset-0" style="background: rgba(0,0,0,0.65);"></div>
    <div class="absolute inset-0 bg-linear-to-t from-black/40 via-transparent to-transparent"></div>
  </div>

  <div class="relative z-10 w-full">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-28 lg:py-40">
      <div class="max-w-2xl">
        <p class="inline-flex items-center gap-2 text-sm font-medium text-primary-300 bg-white/10 backdrop-blur-sm px-4 py-1.5 rounded-full border border-white/10">Nowoczesne kształcenie • Praktyka • Partnerstwo</p>
        <h1 class="mt-10 text-fluid-hero font-display font-extrabold text-white text-balance">Kształcimy z energią, która napędza przyszłość</h1>
        <p class="mt-6 text-fluid-subtitle font-display font-light text-white italic">Nauka, która daje przewagę</p>
        <p class="mt-8 text-lg text-slate-100 max-w-xl leading-relaxed">Przygotowujemy do zawodów przyszłości, stawiając na praktykę, nowoczesne technologie i rozwój kompetencji zawodowych.</p>

        <div class="mt-12 flex flex-wrap gap-4">
          <a href="/rekrutacja" class="inline-flex items-center px-9 py-4 bg-primary-600 text-white font-bold rounded-xl shadow-lg shadow-primary-600/25 hover:bg-primary-700 hover:shadow-primary-700/25 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer text-lg">Rozpocznij rekrutację</a>
          <a href="/kierunki" class="inline-flex items-center px-9 py-4 border-2 border-white/20 text-white font-semibold rounded-xl hover:bg-white/10 hover:border-white/30 transition-all duration-200 cursor-pointer backdrop-blur-sm text-lg">Poznaj kierunki</a>
        </div>


      </div>
    </div>
  </div>
</section>
