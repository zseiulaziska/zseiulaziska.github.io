---
---

<section class="relative w-full min-h-[70vh] flex items-center overflow-hidden bg-navy-950">
  <div class="absolute inset-0">
    <picture>
      <source srcset="/images/333_mundurowi-480w.webp 480w, /images/333_mundurowi-768w.webp 768w, /images/333_mundurowi-1200w.webp 1200w" sizes="100vw" type="image/webp" />
      <img src="/images/333_mundurowi.jpg" alt="Uczniowie ZSEiU" class="w-full h-full object-cover" fetchpriority="high" />
    </picture>
    <div class="absolute inset-0" style="background: rgba(0,0,0,0.65);"></div>
    <div class="absolute inset-0 bg-linear-to-t from-black/40 via-transparent to-transparent"></div>
  </div>

  <div class="relative z-10 w-full">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32">
      <div class="max-w-2xl">
        <p class="inline-flex items-center gap-2 text-sm font-medium text-primary-300 bg-white/10 backdrop-blur-sm px-4 py-1.5 rounded-full border border-white/10">Nowoczesne kształcenie • Praktyka • Partnerstwa</p>
        <h1 class="mt-8 text-4xl sm:text-5xl lg:text-6xl font-display font-extrabold text-white leading-tight">Zaangażowanie. Sukces. Energia i Umiejętności.</h1>
        <p class="mt-3 text-2xl sm:text-3xl font-display font-light text-primary-200 italic">Nauka, która daje przewagę</p>
        <p class="mt-6 text-lg text-slate-300 max-w-xl leading-relaxed">Przygotowujemy do zawodów przyszłości, stawiając na praktykę, nowoczesne technologie i rozwój kompetencji zawodowych.</p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a href="/rekrutacja" class="inline-flex items-center px-8 py-4 bg-primary-600 text-white font-bold rounded-xl shadow-lg shadow-primary-600/25 hover:bg-primary-700 hover:shadow-primary-700/25 hover:-translate-y-0.5 transition-all duration-200 cursor-pointer text-base">Umów się na dzień otwarty</a>
          <a href="/kierunki" class="inline-flex items-center px-8 py-4 border-2 border-white/20 text-white font-semibold rounded-xl hover:bg-white/10 hover:border-white/30 transition-all duration-200 cursor-pointer backdrop-blur-sm text-base">Poznaj kierunki</a>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-x-10 gap-y-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-primary-500/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-primary-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 1.1 2.7 2 6 2s6-.9 6-2v-5"/></svg>
            </div>
            <div>
              <p class="text-lg font-bold text-white leading-tight">580+</p>
              <p class="text-xs text-slate-400">uczniów</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-emerald-500/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg>
            </div>
            <div>
              <p class="text-lg font-bold text-white leading-tight">13</p>
              <p class="text-xs text-slate-400">kierunków</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-violet-500/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            </div>
            <div>
              <p class="text-lg font-bold text-white leading-tight">4</p>
              <p class="text-xs text-slate-400">typy szkół</p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-amber-500/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <p class="text-lg font-bold text-white leading-tight">95%</p>
              <p class="text-xs text-slate-400">zdawalność</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
