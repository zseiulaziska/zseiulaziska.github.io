  </article>

  <style is:global>
    /* Natywny scrollspy: Chrome/Edge 140+. Starsze przeglądarki ignorują
       tę deklarację i dostają fallback z klasy .target-current (patrz skrypt). */
    .toc-scrollspy {
      scroll-target-group: auto;
    }

    /* :is() jest forgiving — nierozpoznany pseudoselektor :target-current
       nie unieważnia całej reguły w przeglądarce fallbacku. */
    .toc-link:is(:target-current, .target-current) {
      background-color: var(--color-primary-50);
      color: var(--color-primary-700);
      font-weight: 700;
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 3px;
    }

    .dark .toc-link:is(:target-current, .target-current) {
      background-color: var(--color-navy-800);
      color: var(--color-primary-300);
    }
  </style>

  <script>
    import { pickActiveTarget, syncTocCurrent } from '../utils/scrollspy';

    const navs = [...document.querySelectorAll<HTMLElement>('[data-scrollspy]')];
    const links = navs.flatMap((nav) => [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')]);

    if (links.length > 0) {
      const supportsNative =
        typeof CSS !== 'undefined' &&
        CSS.supports('scroll-target-group: auto') &&
        CSS.supports('selector(:target-current)');

      if (supportsNative) {
        // Natywny stan wizualny zapewnia :target-current — aktualizujemy tylko ARIA.
        const sync = () => {
          const current = document.querySelector<HTMLAnchorElement>('.toc-link:target-current');
          syncTocCurrent(links, current?.getAttribute('href') ?? null);
        };
        // :target-current zaczyna wskazywać dopiero po pierwszym paintcie —
        // samo wywołanie przy load jeszcze zwraca null (zweryfikowane w Chrome).
        const afterPaint = () => requestAnimationFrame(() => requestAnimationFrame(sync));
        sync();
        afterPaint();
        window.addEventListener('load', afterPaint);
        document.addEventListener('scrollend', sync);
        window.addEventListener('hashchange', sync);

        // :target-current przesuwa się w trakcie przewijania — ARIA nie może
        // czekać do scrollend, inaczej stan wizualny i czytnik ekranu się rozjadą.
        let scrollPending = false;
        window.addEventListener('scroll', () => {
          if (scrollPending) return;
          scrollPending = true;
          requestAnimationFrame(() => {
            scrollPending = false;
            sync();
          });
        }, { passive: true });
      } else {
        // Fallback: linia czytania w połowie viewportu wyznacza aktywną sekcję.
        const targets = links.flatMap((link) => {
          const href = link.getAttribute('href');
          const target = href ? document.getElementById(href.slice(1)) : null;
          return target ? [target] : [];
        });
        let activeTarget: string | null = null;

        const sync = () => syncTocCurrent(links, activeTarget);
        sync();

        const observer = new IntersectionObserver((entries) => {
          const activeId = pickActiveTarget(entries.map((entry) => ({
            id: entry.target.id,
            isIntersecting: entry.isIntersecting,
            boundingClientRect: entry.boundingClientRect,
          })));
          if (activeId !== null) {
            activeTarget = `#${activeId}`;
            sync();
          }
        }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });

        targets.forEach((target) => observer.observe(target));
      }
    }
  </script>
</Layout>
