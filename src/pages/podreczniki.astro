---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const entries = await getCollection('podreczniki');

const schoolOrder: Record<string, number> = {
  'Technikum': 0,
  'Branżowa Szkoła I Stopnia': 1,
  'Lieceum Ogólnokształcące dla Dorosłych': 2,
};

entries.sort((a, b) => {
  const aOrder = schoolOrder[a.data.typ_szkoly] ?? 99;
  const bOrder = schoolOrder[b.data.typ_szkoly] ?? 99;
  if (aOrder !== bOrder) return aOrder - bOrder;
  return parseInt(a.data.klasa, 10) - parseInt(b.data.klasa, 10);
});

function getSkroconyTyp(entry: typeof entries[0]): string {
  return entry.data.skroconyTyp ?? (
    entry.data.typ_szkoly === 'Technikum' ? 'T'
    : entry.data.typ_szkoly === 'Branżowa Szkoła I Stopnia' ? 'BS1S'
    : 'LO'
  );
}

const accentMap: Record<string, string> = {
  T: 'primary',
  BS1S: 'emerald',
  LO: 'violet',
};

const dotColorMap: Record<string, string> = {
  T: 'bg-primary-500',
  BS1S: 'bg-emerald-500',
  LO: 'bg-violet-500',
};

const borderColorMap: Record<string, string> = {
  T: 'border-primary-500',
  BS1S: 'border-emerald-500',
  LO: 'border-violet-500',
};

const badgeBgMap: Record<string, string> = {
  T: 'bg-navy-100 dark:bg-navy-700',
  BS1S: 'bg-emerald-100 dark:bg-emerald-950/60',
  LO: 'bg-violet-100 dark:bg-violet-950/60',
};

const badgeTextMap: Record<string, string> = {
  T: 'text-navy-700 dark:text-navy-300',
  BS1S: 'text-emerald-700 dark:text-emerald-300',
  LO: 'text-violet-700 dark:text-violet-300',
};

const rendered = await Promise.all(entries.map(async (entry) => {
  const { Content } = await render(entry);
  return { ...entry, Content };
}));
---

<Layout title="Podręczniki 2026/2027 - ZSEiU Łaziska Górne" description="Wykaz podręczników szkolnych dla Technikum w ZSEiU Łaziska Górne na rok szkolny 2026/2027.">

  <article class="w-full max-w-5xl mx-auto min-w-0">

    <!-- HERO -->
    <div class="relative overflow-hidden rounded-2xl bg-linear-to-br from-slate-900 via-navy-950 to-slate-900 dark:from-navy-950 dark:via-navy-900 dark:to-navy-950 border border-slate-700/50 dark:border-navy-700/50 p-5 sm:p-10 mb-10 w-full">
      <div class="cyber-grid absolute inset-0 opacity-20" aria-hidden="true"></div>
      <div class="cyber-glow absolute -top-20 -right-20 w-80 h-80 bg-primary-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="cyber-glow absolute -bottom-20 -left-20 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="relative z-10">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-primary-500/20 text-primary-300 border border-primary-500/30 mb-4">Wykaz Podręczników</span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white mb-3 leading-tight wrap-break-word">Podręczniki <span class="text-transparent bg-clip-text bg-linear-to-r from-primary-300 via-primary-400 to-blue-400">2026/2027</span></h1>
        <p class="text-base sm:text-xl text-slate-300 max-w-2xl leading-relaxed wrap-break-word">Kompletny wykaz podręczników dla wszystkich klas Technikum — przedmioty ogólnokształcące oraz kształcenie zawodowe.</p>
      </div>
    </div>

    <!-- NARZĘDZIA: FILTRY + DRUKUJ -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8" id="toolbar">
      <div class="flex flex-wrap items-center gap-2">
        <button data-filter="all" data-school="" class="class-filter active px-3 py-1.5 rounded-lg text-xs font-semibold transition-all duration-200 bg-primary-600 text-white shadow-xs">Wszystkie</button>
        {rendered.map(({ data }) => {
          const st = getSkroconyTyp({ data } as typeof entries[0]);
          const dotColor = dotColorMap[st] ?? 'bg-primary-500';
          return <button data-filter={`${st}-${data.klasa}`} data-school={data.typ_szkoly} class="class-filter px-3 py-1.5 rounded-lg text-xs font-semibold transition-all duration-200 bg-white dark:bg-navy-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-navy-700 hover:bg-slate-100 dark:hover:bg-navy-700"><span class={`inline-block w-2 h-2 rounded-full ${dotColor} mr-1.5`}></span>{st} - Klasa {data.klasa}</button>;
        })}
      </div>
      <div class="flex items-center gap-2 self-start sm:self-auto">
        <button id="print-btn" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-slate-200 dark:border-navy-600 bg-white dark:bg-navy-800/90 text-slate-700 dark:text-slate-300 text-sm font-semibold hover:bg-slate-100 dark:hover:bg-navy-700 transition-all" title="Drukuj">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          Drukuj
        </button>
      </div>
    </div>

    <!-- SEKCJE KLAS -->
    {rendered.map(({ Content, data }, i) => {
      const st = getSkroconyTyp({ data } as typeof entries[0]);
      const borderColor = borderColorMap[st] ?? 'border-primary-500';
      const badgeBg = badgeBgMap[st] ?? 'bg-navy-100 dark:bg-navy-700';
      const badgeText = badgeTextMap[st] ?? 'text-navy-700 dark:text-navy-300';
      return (
        <>
          <section class="klasa-section mb-12" data-klasa={`${st}-${data.klasa}`}>
            <div class={`flex items-center gap-3 mb-6 border-l-4 ${borderColor} pl-3 sm:pl-4`}>
              <span class={`px-2.5 py-0.5 rounded-full ${badgeBg} ${badgeText} text-xs font-semibold`}>{data.typ_szkoly}</span>
              <h2 class="text-xl sm:text-3xl font-bold text-slate-900 dark:text-white leading-snug wrap-break-word">Klasa {data.klasa}</h2>
            </div>
            <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:text-slate-900 dark:prose-headings:text-white prose-headings:font-bold prose-headings:text-lg prose-a:text-primary-600 dark:prose-a:text-primary-400 prose-strong:text-slate-900 dark:prose-strong:text-white prose-ul:list-disc prose-ul:list-outside prose-ul:pl-5 prose-li:text-sm prose-li:leading-relaxed prose-li:text-slate-700 dark:prose-li:text-slate-300 prose-li:marker:text-slate-400">
              <Content />
            </div>
          </section>
          {i < rendered.length - 1 && <hr class="my-10 border-slate-200 dark:border-navy-700" />}
        </>
      );
    })}

  </article>
</Layout>

<style is:global>
  .klasa-section .prose ul ul {
    padding-left: 2.5rem;
  }

  @media print {
    .site-header,
    .site-header *,
    .breadcrumbs,
    #toolbar,
    footer,
    .skip-link,
    article > div:first-child {
      display: none !important;
    }
    body {
      background: white !important;
      color: black !important;
    }
    .dark body,
    html.dark body {
      background: white !important;
      color: black !important;
    }
    .klasa-section {
      page-break-inside: avoid;
      break-inside: avoid;
    }
    .text-slate-900,
    .dark\:text-white {
      color: #111827 !important;
    }
    .text-slate-700,
    .text-slate-600,
    .text-slate-500,
    .text-slate-400,
    .dark\:text-slate-300,
    .dark\:text-slate-400,
    .dark\:text-slate-500 {
      color: #4b5563 !important;
    }
    .text-primary-700,
    .dark\:text-primary-300,
    .text-slate-700 {
      color: #0070b0 !important;
    }
    .border-slate-700\/50,
    .dark\:border-navy-700\/50 {
      border: none !important;
      background: transparent !important;
    }
    .cyber-grid,
    .cyber-glow {
      display: none !important;
    }
    h1, h2, h3 {
      color: #111827 !important;
    }
    @page {
      margin: 1.5cm;
    }
  }
</style>

<script>
  (function () {
    const classFilters = document.querySelectorAll('.class-filter');
    const klasaSections = document.querySelectorAll('.klasa-section');

    const activeBg = (school) => {
      if (school === 'Branżowa Szkoła I Stopnia') return 'bg-emerald-600';
      if (school === 'Lieceum Ogólnokształcące dla Dorosłych') return 'bg-violet-600';
      return 'bg-primary-600';
    };

    classFilters.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'all';
        const school = btn.getAttribute('data-school');

        classFilters.forEach((b) => {
          b.classList.remove('active', 'bg-primary-600', 'bg-emerald-600', 'text-white', 'shadow-xs');
          b.classList.add('bg-white', 'dark:bg-navy-800', 'text-slate-700', 'dark:text-slate-300', 'border', 'border-slate-200', 'dark:border-navy-700');
        });
        btn.classList.add('active', activeBg(school), 'text-white', 'shadow-xs');
        btn.classList.remove('bg-white', 'dark:bg-navy-800', 'text-slate-700', 'dark:text-slate-300', 'border', 'border-slate-200', 'dark:border-navy-700');

        klasaSections.forEach((section) => {
          const data = section.getAttribute('data-klasa');
          if (filter === 'all' || data === filter) {
            section.style.display = '';
          } else {
            section.style.display = 'none';
          }
        });
      });
    });

    const printBtn = document.getElementById('print-btn');
    if (printBtn) {
      printBtn.addEventListener('click', () => {
        window.print();
      });
    }
  })();
</script>
