---
import Layout from '../layouts/Layout.astro';
---
<!--
  Plan zajęć LO dla Dorosłych – ZSEiU Łaziska Górne
  
  Dane pobierane z Google Apps Script (arkusz Google).
  Aplikacja wyświetla plan zjazdów dla wybranej klasy
  w podziale na dzień, miesiąc, semestr lub cały rok.
-->
<Layout
  title="Plan zajęć LO dla Dorosłych - ZSEiU Łaziska Górne"
  description="Plan zajęć Liceum dla Dorosłych w ZSEiU Łaziska Górne. Sprawdź daty zjazdów i rozkład lekcji dla wybranej klasy."
>
  <div id="plan-app" class="w-full max-w-6xl mx-auto px-4 py-6">
    <!-- Nagłówek -->
    <h1 class="text-center text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white mb-6">
      Plan zajęć LO dla Dorosłych
    </h1>

    <!-- Kontrolki -->
    <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
      <select
        id="class-select"
        class="min-w-[200px] px-4 py-2.5 rounded-xl border border-slate-300 dark:border-navy-600 bg-white dark:bg-navy-800 text-slate-800 dark:text-slate-200 text-sm font-medium shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors"
        aria-label="Wybierz klasę"
      >
        <option value="">Wybierz klasę…</option>
      </select>

      <div class="flex gap-2" id="view-tabs" role="tablist" aria-label="Widok">
        <button class="view-btn active" data-view="day" role="tab" aria-selected="true">Dzień</button>
        <button class="view-btn" data-view="month" role="tab" aria-selected="false">Miesiąc</button>
        <button class="view-btn" data-view="semester" role="tab" aria-selected="false">Semestr</button>
        <button class="view-btn" data-view="year" role="tab" aria-selected="false">Rok</button>
      </div>

      <button
        id="print-btn"
        class="px-5 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold shadow-sm transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-navy-900"
        type="button"
      >
        <svg class="inline-block w-4 h-4 mr-1.5 -mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
        Drukuj
      </button>
    </div>

    <!-- Nawigacja dat -->
    <div id="date-nav" class="flex items-center justify-center gap-4 mb-6 min-h-[2.5rem]">
      <button id="prev-btn" class="nav-arrow" aria-label="Poprzedni">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <span id="date-label" class="text-base sm:text-lg font-bold text-slate-800 dark:text-slate-100 min-w-[200px] text-center">
        Wybierz klasę
      </span>
      <button id="next-btn" class="nav-arrow" aria-label="Następny">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>

    <!-- Siatka zajęć -->
    <div id="schedule-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
      <div id="loading-placeholder" class="col-span-full text-center py-12 text-slate-400 dark:text-slate-500">
        <svg class="inline-block w-12 h-12 mb-4 animate-spin text-primary-500" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-dasharray="31.4 31.4" stroke-linecap="round"/>
        </svg>
        <p class="text-lg font-medium">Ładowanie planu lekcji…</p>
      </div>
    </div>
  </div>

  <style>
    .view-btn {
      padding: 0.5rem 1rem;
      border-radius: 0.75rem;
      font-size: 0.875rem;
      font-weight: 600;
      border: 2px solid var(--color-slate-200, #e2e8f0);
      background: var(--color-white, #fff);
      color: var(--color-slate-600, #475569);
      transition: all 0.15s;
      cursor: pointer;
    }
    .view-btn:hover {
      border-color: var(--color-primary-400, #38bdf8);
      color: var(--color-primary-600, #0070b0);
    }
    .view-btn.active {
      border-color: var(--color-primary-600, #0070b0);
      background: var(--color-primary-50, #f5fbff);
      color: var(--color-primary-700, #0077cc);
    }
    :global(.dark) .view-btn {
      background: var(--color-navy-800, #121f3f);
      border-color: var(--color-navy-600, #1e3a5f);
      color: var(--color-slate-300, #cbd5e1);
    }
    :global(.dark) .view-btn:hover {
      border-color: var(--color-primary-500, #06a6ff);
      color: var(--color-primary-300, #7ed0ff);
    }
    :global(.dark) .view-btn.active {
      border-color: var(--color-primary-400, #38bdf8);
      background: rgba(6, 166, 255, 0.15);
      color: var(--color-primary-300, #7ed0ff);
    }
    .nav-arrow {
      padding: 0.5rem;
      border-radius: 9999px;
      border: 1px solid var(--color-slate-200, #e2e8f0);
      background: var(--color-white, #fff);
      color: var(--color-slate-600, #475569);
      transition: all 0.15s;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .nav-arrow:hover {
      background: var(--color-slate-100, #f1f5f9);
      color: var(--color-primary-600, #0070b0);
    }
    .nav-arrow:disabled {
      opacity: 0.3;
      cursor: not-allowed;
    }
    :global(.dark) .nav-arrow {
      background: var(--color-navy-800, #121f3f);
      border-color: var(--color-navy-600, #1e3a5f);
      color: var(--color-slate-300, #cbd5e1);
    }
    :global(.dark) .nav-arrow:hover {
      background: var(--color-navy-700, #162544);
      color: var(--color-primary-300, #7ed0ff);
    }
  </style>

  <script>
    (function () {
      'use strict';

      /* ── konfiguracja ── */
      const DATA_URL = '/api/plan-csv.json';

      const SUBJECT_MAP = {
        m: 'Matematyka', jp: 'Język polski', ja: 'Język angielski',
        w: 'Wiedza o społeczeństwie', i: 'Informatyka', g: 'Geografia',
        b: 'Biologia', ch: 'Chemia', f: 'Fizyka', h: 'Historia',
      };
      const SUBJECT_COLORS = {
        m: '#4fc3f7', jp: '#e94560', ja: '#ffb74d', w: '#81c784', i: '#ce93d8',
        g: '#a1887f', b: '#66bb6a', ch: '#ef5350', f: '#42a5f5', h: '#ff8a65',
      };
      const DAY_SHORT = ['Nd', 'Pn', 'Wt', 'Śr', 'Cz', 'Pt', 'So'];
      const MONTH_NAMES = ['stycznia','lutego','marca','kwietnia','maja','czerwca','lipca','sierpnia','września','października','listopada','grudnia'];

      /* ── stan ── */
      let allData = null;
      let selectedClass = '';
      let currentView = 'day';       // day | month | semester | year
      let navigationItems = [];      // lista { label, dateKeys[] }
      let currentNavIndex = 0;

      const classSelect = document.getElementById('class-select');
      const scheduleGrid = document.getElementById('schedule-grid');
      const dateLabelEl = document.getElementById('date-label');
      const prevBtn = document.getElementById('prev-btn');
      const nextBtn = document.getElementById('next-btn');
      const printBtn = document.getElementById('print-btn');
      const viewBtns = document.querySelectorAll('.view-btn');

      /* ── helpery ── */
      function resolveSubject(raw) {
        const key = (raw || '').trim().toLowerCase();
        return SUBJECT_MAP[key] || raw.trim() || '—';
      }

      function formatDateLong(d) {
        const dw = ['Niedziela','Poniedziałek','Wtorek','Środa','Czwartek','Piątek','Sobota'];
        return dw[d.getDay()] + ', ' + d.getDate() + ' ' + MONTH_NAMES[d.getMonth()] + ' ' + d.getFullYear();
      }

      function formatDateShort(d) {
        return d.getDate() + '.' + String(d.getMonth() + 1).padStart(2, '0') + '.' + d.getFullYear();
      }

      function parseDate(key) {
        try {
          const d = new Date(key);
          if (isNaN(d.getTime())) {
            const parts = key.split('-');
            if (parts.length === 3 && parts.every(function (p) { return !isNaN(Number(p)); })) {
              return new Date(+parts[0], +parts[1] - 1, +parts[2]);
            }
          }
          if (!isNaN(d.getTime())) return d;
        } catch (e) { /* fall through */ }
        return new Date(NaN);
      }

      function getMonthKey(date) {
        return date.getFullYear() + '-' + String(date.getMonth() + 1).padStart(2, '0');
      }

      function getMonthLabel(date) {
        const m = ['Styczeń','Luty','Marzec','Kwiecień','Maj','Czerwiec','Lipiec','Sierpień','Wrzesień','Październik','Listopad','Grudzień'];
        return m[date.getMonth()] + ' ' + date.getFullYear();
      }

      /* ── pobieranie danych ── */
      async function fetchData() {
        const resp = await fetch(DATA_URL + '?_=' + Date.now());
        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        const data = await resp.json();
        if (data.error) throw new Error(data.error);
        return data;
      }

      /* ── budowanie nawigacji ── */
      function buildNavigation(dateKeys) {
        if (!dateKeys.length) return [{ label: 'Brak dat', dateKeys: [] }];

        const dates = dateKeys.map(k => parseDate(k));

        if (currentView === 'day') {
          return dateKeys.map((k, i) => ({
            label: formatDateLong(dates[i]),
            dateKeys: [k],
          }));
        }

        if (currentView === 'month') {
          const map = {};
          dateKeys.forEach((k, i) => {
            const d = dates[i];
            if (!d || isNaN(d.getTime())) return;
            const mk = getMonthKey(d);
            if (!map[mk]) map[mk] = { label: getMonthLabel(d), dateKeys: [] };
            map[mk].dateKeys.push(k);
          });
          return Object.values(map);
        }

        if (currentView === 'semester') {
          // semestr I: IX–I (miesiące 8,9,10,11,0), semestr II: II–VI (miesiące 1,2,3,4,5)
          const sem = { 1: { label: 'Semestr I (wrzesień–styczeń)', dateKeys: [] }, 2: { label: 'Semestr II (luty–czerwiec)', dateKeys: [] } };
          dateKeys.forEach(function (k, i) {
            const d = dates[i];
            if (!d || isNaN(d.getTime())) return;
            const m = d.getMonth();
            const s = (m >= 8 || m <= 0) ? 1 : 2;
            sem[s].dateKeys.push(k);
          });
          const r = [];
          if (sem[1].dateKeys.length) r.push(sem[1]);
          if (sem[2].dateKeys.length) r.push(sem[2]);
          return r;
        }

        if (currentView === 'year') {
          const map = {};
          dateKeys.forEach((k, i) => {
            const d = dates[i];
            const m = d.getMonth() + 1; // 1–12
            const y = d.getFullYear();
            // rok szkolny: IX–VI -> np. wrzesień 2024 należy do 2024/2025
            const schoolYearStart = m >= 9 ? y : y - 1;
            const label = 'Rok szkolny ' + schoolYearStart + '/' + (schoolYearStart + 1);
            if (!map[schoolYearStart]) map[schoolYearStart] = { label: label, keys: [] };
            map[schoolYearStart].keys.push(k);
          });
          return Object.values(map).map(g => ({ label: g.label, dateKeys: g.keys }));
        }

        return [{ label: '', dateKeys }];
      }

      /* ── renderowanie ── */
      let currentDayOffset = 0; // index within current navigation item's dateKeys (mobile)

      function isMobile() {
        return window.innerWidth < 768;
      }

      function renderSchedule(className, data) {
        if (!data || !data[className]) {
          scheduleGrid.innerHTML = '<div class="col-span-full text-center py-12 text-slate-400 dark:text-slate-500"><p class="text-lg">Brak danych dla klasy ' + className + '</p></div>';
          dateLabelEl.textContent = 'Brak danych';
          prevBtn.disabled = true;
          nextBtn.disabled = true;
          navigationItems = [];
          currentNavIndex = 0;
          currentDayOffset = 0;
          return;
        }

        const classData = data[className];
        const dateKeys = Object.keys(classData).sort();

        navigationItems = buildNavigation(dateKeys);
        currentNavIndex = 0;
        currentDayOffset = 0;
        renderCurrentNavigationItem();
      }

      function renderDayCards(dateKeysToRender, centerIndex) {
        const classData = allData[selectedClass];

        // Pojedynczy dzień: karta (widok Dzień lub gdy jest tylko jeden dzień)
        if (dateKeysToRender.length <= 1) {
          let html = '';
          dateKeysToRender.forEach(function (key) {
            const d = parseDate(key);
            const lessons = classData[key] || [];
            const dayName = ['Niedziela','Poniedziałek','Wtorek','Środa','Czwartek','Piątek','Sobota'][d.getDay()];
            html += '<div class="day-card day-card-single">';
            html += '<div class="day-card-header">';
            html += '<span class="day-name">' + dayName + '</span>';
            html += '<span class="day-date">' + formatDateShort(d) + '</span>';
            html += '</div>';
            if (!lessons.length) {
              html += '<div class="day-card-empty">Brak lekcji</div>';
            } else {
              html += '<div class="lessons-list">';
              lessons.forEach(function (lesson) {
                var raw = lesson.subject || '';
                var isEmpty = !raw.trim();
                var display = resolveSubject(raw);
                var colorKey = raw.trim().toLowerCase();
                var color = SUBJECT_COLORS[colorKey] || null;
                var borderStyle = color ? 'border-left-color:' + color + ';border-left-width:4px' : '';
                var nrStyle = color ? 'color:' + color + ';' : '';
                html += '<div class="lesson-item' + (isEmpty ? ' empty' : '') + '" style="' + borderStyle + '">';
                html += '<span class="lesson-nr-big" style="' + nrStyle + '">' + (lesson.nr || '') + '</span>';
                html += '<div class="lesson-info">';
                html += '<span class="lesson-time">' + (lesson.start || '') + '–' + (lesson.stop || '') + '</span>';
                html += '<span class="lesson-subject"' + (color ? ' style="color:' + color + '"' : '') + '>' + display + '</span>';
                html += '</div>';
                html += '</div>';
              });
              html += '</div>';
            }
            html += '</div>';
          });
          return html;
        }

        // Wiele dni (miesiąc/semestr/rok): tabela z kolumnami = dni, wierszami = numery lekcji
        var allDays = dateKeysToRender.map(function (key) {
          return {
            key: key,
            date: parseDate(key),
            lessons: classData[key] || []
          };
        });

        // Zbierz unikalne numery lekcji we właściwej kolejności
        var allNrs = [];
        var seenNr = {};
        allDays.forEach(function (day) {
          day.lessons.forEach(function (lesson) {
            var nr = String(lesson.nr || '').trim();
            if (nr && !seenNr[nr]) {
              seenNr[nr] = true;
              allNrs.push(nr);
            }
          });
        });
        allNrs.sort(function (a, b) { return parseInt(a, 10) - parseInt(b, 10); });

        var html = '<div class="col-span-full"><div class="schedule-table">';

        // Wiersz nagłówka z datami
        html += '<div class="table-row table-header">';
        html += '<div class="table-col table-nr-header"></div>';
        allDays.forEach(function (day) {
          var dayName = ['Niedziela','Poniedziałek','Wtorek','Środa','Czwartek','Piątek','Sobota'][day.date.getDay()];
          html += '<div class="table-col table-header-cell">';
          html += '<div class="day-name">' + dayName + '</div>';
          html += '<div class="table-date">' + formatDateShort(day.date) + '</div>';
          html += '</div>';
        });
        html += '</div>';

        // Wiersze lekcyjne
        allNrs.forEach(function (nr) {
          html += '<div class="table-row">';
          html += '<div class="table-col table-nr-cell">' + nr + '</div>';
          allDays.forEach(function (day) {
            // Znajdź pierwszą lekcję z tym numerem, która ma niepusty przedmiot
            var lesson = null;
            for (var li = 0; li < day.lessons.length; li++) {
              if (String(day.lessons[li].nr) === nr) {
                lesson = day.lessons[li];
                break;
              }
            }
            if (lesson && lesson.subject && lesson.subject.trim()) {
              var raw = lesson.subject;
              var display = resolveSubject(raw);
              var colorKey = raw.trim().toLowerCase();
              var color = SUBJECT_COLORS[colorKey] || null;
              var borderStyle = color ? 'border-left-color:' + color : '';
              html += '<div class="table-col table-cell" style="' + borderStyle + '">';
              html += '<div class="lesson-time">' + (lesson.start || '') + '–' + (lesson.stop || '') + '</div>';
              html += '<div class="lesson-subject"' + (color ? ' style="color:' + color + '"' : '') + '>' + display + '</div>';
              html += '</div>';
            } else {
              html += '<div class="table-col table-cell empty"></div>';
            }
          });
          html += '</div>';
        });

        html += '</div></div>';
        return html;
      }

      function renderCurrentNavigationItem() {
        if (!navigationItems.length) {
          scheduleGrid.innerHTML = '<div class="col-span-full text-center py-12 text-slate-400 dark:text-slate-500"><p class="text-lg">Brak danych</p></div>';
          dateLabelEl.textContent = '—';
          prevBtn.disabled = true;
          nextBtn.disabled = true;
          return;
        }

        const item = navigationItems[currentNavIndex];
        const dayKeys = item.dateKeys;

        if (!dayKeys.length) {
          scheduleGrid.innerHTML = '<div class="col-span-full text-center py-12 text-slate-400 dark:text-slate-500"><p class="text-lg">Brak zajęć w tym okresie</p></div>';
          dateLabelEl.textContent = item.label;
          prevBtn.disabled = currentNavIndex <= 0;
          nextBtn.disabled = currentNavIndex >= navigationItems.length - 1;
          return;
        }

        // Clamp currentDayOffset (used only in 'day' view on mobile)
        if (currentDayOffset >= dayKeys.length) currentDayOffset = dayKeys.length - 1;
        if (currentDayOffset < 0) currentDayOffset = 0;

        const allKeys = navigationItems.map(function (navItem) { return navItem.dateKeys; }).flat();
        const currentKey = dayKeys[currentDayOffset];
        const flatIdx = allKeys.indexOf(currentKey);

        // Always show the group label (month/semester/year name)
        dateLabelEl.textContent = item.label;

        // Build keys to render
        var keysToRender = [];
        var centerIdx = 0;

        if (currentView === 'day') {
          // Day view: always show one day at a time
          keysToRender = [currentKey];
          centerIdx = 0;
        } else {
          // Month/semester/year: show ALL days in the group
          // (on both mobile and desktop — mobile gets a single-column scrollable list)
          dayKeys.forEach(function (k) { keysToRender.push(k); });
          centerIdx = -1; // no adjacent/center styling
        }

        // Update arrow disabled state: arrows navigate between groups (months/semesters/years)
        prevBtn.disabled = currentNavIndex <= 0;
        nextBtn.disabled = currentNavIndex >= navigationItems.length - 1;

        var html = renderDayCards(keysToRender, centerIdx);
        scheduleGrid.innerHTML = html;
      }

      /* ── inicjalizacja ── */
      (async function init() {
        try {
          allData = await fetchData();
          const names = Object.keys(allData).sort();
          classSelect.innerHTML = '<option value="">Wybierz klasę…</option>' +
            names.map(function (c) { return '<option value="' + c + '">Klasa ' + c + '</option>'; }).join('');
          scheduleGrid.innerHTML = '<div class="col-span-full text-center py-12 text-slate-400 dark:text-slate-500"><p class="text-lg">Wybierz klasę, aby zobaczyć plan.</p></div>';
        } catch (e) {
          classSelect.innerHTML = '<option value="">Błąd wczytywania</option>';
          scheduleGrid.innerHTML = '<div class="col-span-full text-center py-12 text-red-500 dark:text-red-400"><p class="text-lg font-semibold">Nie udało się załadować planu.</p><p class="text-sm mt-2 opacity-70">' + e.message + '</p></div>';
        } finally {
          document.getElementById('loading-placeholder')?.remove();
        }
      })();

      /* ── zdarzenia ── */
      classSelect.addEventListener('change', function () {
        selectedClass = this.value;
        if (!selectedClass || !allData) {
          scheduleGrid.innerHTML = '<div class="col-span-full text-center py-12 text-slate-400 dark:text-slate-500"><p class="text-lg">Wybierz klasę, aby zobaczyć plan.</p></div>';
          dateLabelEl.textContent = 'Wybierz klasę';
          prevBtn.disabled = true;
          nextBtn.disabled = true;
          return;
        }
        renderSchedule(selectedClass, allData);
      });

      function goPrev() {
        if (currentView === 'day') {
          // Day view: navigate days
          const allKeys = navigationItems.map(function (navItem) { return navItem.dateKeys; }).flat();
          const currentKey = navigationItems[currentNavIndex].dateKeys[currentDayOffset];
          const flatIdx = allKeys.indexOf(currentKey);
          if (flatIdx > 0) {
            // Go to previous day
            const prevAllKeys = allKeys[flatIdx - 1];
            for (var ni = 0; ni < navigationItems.length; ni++) {
              for (var di = 0; di < navigationItems[ni].dateKeys.length; di++) {
                if (navigationItems[ni].dateKeys[di] === prevAllKeys) {
                  currentNavIndex = ni;
                  currentDayOffset = di;
                  renderCurrentNavigationItem();
                  return;
                }
              }
            }
          }
        } else {
          // Month/semester/year view: navigate between groups
          if (currentNavIndex > 0) {
            currentNavIndex--;
            currentDayOffset = 0;
            renderCurrentNavigationItem();
          }
        }
      }

      function goNext() {
        if (currentView === 'day') {
          // Day view: navigate days
          const allKeys = navigationItems.map(function (navItem) { return navItem.dateKeys; }).flat();
          const currentKey = navigationItems[currentNavIndex].dateKeys[currentDayOffset];
          const flatIdx = allKeys.indexOf(currentKey);
          if (flatIdx < allKeys.length - 1) {
            // Go to next day
            const nextAllKeys = allKeys[flatIdx + 1];
            for (var ni = 0; ni < navigationItems.length; ni++) {
              for (var di = 0; di < navigationItems[ni].dateKeys.length; di++) {
                if (navigationItems[ni].dateKeys[di] === nextAllKeys) {
                  currentNavIndex = ni;
                  currentDayOffset = di;
                  renderCurrentNavigationItem();
                  return;
                }
              }
            }
          }
        } else {
          // Month/semester/year view: navigate between groups
          if (currentNavIndex < navigationItems.length - 1) {
            currentNavIndex++;
            currentDayOffset = 0;
            renderCurrentNavigationItem();
          }
        }
      }

      prevBtn.addEventListener('click', goPrev);
      nextBtn.addEventListener('click', goNext);

      // Reset day offset when view changes
      function onViewChange() {
        currentDayOffset = 0;
        if (selectedClass && allData) {
          renderSchedule(selectedClass, allData);
        }
      }

      viewBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          viewBtns.forEach(function (b) {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          this.classList.add('active');
          this.setAttribute('aria-selected', 'true');
          currentView = this.dataset.view;
          onViewChange();
        });
      });

      printBtn.addEventListener('click', function () {
        window.print();
      });

      /* ── klawiatura ── */
      document.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft' && !prevBtn.disabled) goPrev();
        if (e.key === 'ArrowRight' && !nextBtn.disabled) goNext();
      });

      // Re-render on resize for mobile/desktop switch
      var resizeTimer;
      window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function () {
          if (selectedClass && allData) renderCurrentNavigationItem();
        }, 200);
      });

    })();
  </script>
</Layout>

