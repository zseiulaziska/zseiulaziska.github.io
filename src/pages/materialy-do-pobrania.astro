---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import DownloadCard from '../components/DownloadCard.astro';
import { downloadCountWord, groupDownloads, visibleDownloads } from '../utils/downloads-catalog';

const entries = await getCollection('downloads');
const groups = groupDownloads(visibleDownloads(entries));
---

<Layout
  title="Materiały do pobrania - ZSEiU Łaziska Górne"
  description="Katalog materiałów do pobrania ZSEiU Łaziska Górne: identyfikacja wizualna, ulotki, dokumenty i publikacje oraz multimedia."
>
  <article class="w-full max-w-5xl mx-auto min-w-0">
    <div class="relative overflow-hidden rounded-2xl bg-linear-to-br from-slate-900 via-navy-950 to-slate-900 dark:from-navy-950 dark:via-navy-900 dark:to-navy-950 border border-slate-700/50 dark:border-navy-700/50 p-5 sm:p-10 mb-10 w-full">
      <div class="cyber-grid absolute inset-0 opacity-20" aria-hidden="true"></div>
      <div class="cyber-glow absolute -top-20 -right-20 w-80 h-80 bg-primary-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="relative z-10">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-primary-500/20 text-primary-300 border border-primary-500/30 mb-4">Zasoby szkoły</span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white mb-3 leading-tight wrap-break-word">
          Materiały <span class="text-transparent bg-clip-text bg-linear-to-r from-primary-300 via-primary-400 to-blue-400">do pobrania</span>
        </h1>
        <p class="text-base sm:text-xl text-slate-300 max-w-2xl leading-relaxed wrap-break-word">
          Oficjalne materiały naszej szkoły — dokumenty, ulotki i pliki do pobrania w jednym miejscu.
        </p>
      </div>
    </div>

    {
      groups.length === 0 ? (
        <p class="rounded-xl border border-slate-200 dark:border-navy-700 bg-white dark:bg-navy-800/70 p-6 text-slate-700 dark:text-slate-300">
          Brak opublikowanych materiałów. Katalog zostanie uzupełniony wkrótce.
        </p>
      ) : (
        groups.map((group) => (
          <section aria-labelledby={`kategoria-${group.id}`} class="mb-12">
            <h2
              id={`kategoria-${group.id}`}
              class="text-xl sm:text-3xl font-bold text-slate-900 dark:text-white mb-6 pl-3 sm:pl-4 border-l-4 border-primary-500 leading-snug wrap-break-word"
            >
              {group.label}
              <span class="ml-2 inline-flex items-center justify-center px-2.5 py-1 rounded-full bg-primary-100 dark:bg-primary-950/60 text-primary-700 dark:text-primary-300 text-sm font-semibold align-middle">
                {group.count}<span class="sr-only"> {downloadCountWord(group.count)}</span>
              </span>
            </h2>

            <ul class="grid grid-cols-1 md:grid-cols-2 gap-5 list-none p-0 m-0">
              {group.items.map((item) => (
                <li class="min-w-0">
                  <DownloadCard item={item} />
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
  </article>
</Layout>
