---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Podręczniki - Technikum - ZSEiU Łaziska Górne" description="Wykaz podręczników dla technikum ZSEiU Łaziska Górne.">

  <article class="w-full max-w-5xl mx-auto min-w-0">

    <!-- HERO -->
    <div class="relative overflow-hidden rounded-2xl bg-linear-to-br from-slate-900 via-navy-950 to-slate-900 dark:from-navy-950 dark:via-navy-900 dark:to-navy-950 border border-slate-700/50 dark:border-navy-700/50 p-5 sm:p-10 mb-10 w-full">
      <div class="cyber-grid absolute inset-0 opacity-20" aria-hidden="true"></div>
      <div class="cyber-glow absolute -top-20 -right-20 w-80 h-80 bg-primary-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="cyber-glow absolute -bottom-20 -left-20 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="relative z-10">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-primary-500/20 text-primary-300 border border-primary-500/30 mb-4">Podręczniki</span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white mb-3 leading-tight wrap-break-word">Podręczniki <span class="text-transparent bg-clip-text bg-linear-to-r from-primary-300 via-primary-400 to-blue-400">Technikum</span></h1>
        <p class="text-base sm:text-xl text-slate-300 max-w-2xl leading-relaxed wrap-break-word">Wykaz podręczników obowiązujących w Technikum Nr 1 w ZSEiU Łaziska Górne.</p>
      </div>
    </div>

    <div class="iframe-responsive-wrapper">
      <iframe 
        src="https://docs.google.com/document/d/e/2PACX-1vQ8Dout0rU1esWfRCVWZUWQaxiAB6f7eLe6SeU2xLdRUK8TMWb6Yo7Or1-kSeU1-g2pSMa6sPY9il5T/pub?embedded=true" 
        title="Lista podręczników"
        loading="lazy">
      </iframe>
    </div>

    <style>
      .iframe-responsive-wrapper {
        position: relative;
        width: 100%;
        max-width: 100%;
        -webkit-overflow-scrolling: touch;
        overflow-y: auto;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }

      iframe {
        width: 100%;
        height: 75vh;
        min-height: 500px;
        border: none;
        display: block;
      }

      @media (max-width: 600px) {
        iframe {
          height: 85vh;
          min-height: 400px;
        }
      }
    </style>

  </article>

</Layout>
