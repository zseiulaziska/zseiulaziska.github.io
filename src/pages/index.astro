---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

import { getCollection } from 'astro:content';
import SchoolFields from '../components/SchoolFields.astro';
import PartnersSection from '../components/PartnersSection.astro';
import SuccessSection from '../components/SuccessSection.astro';
import WhyChooseSection from '../components/WhyChooseSection.astro';
import NewsSection from '../components/NewsSection.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.filter(p => !p.data.draft).sort((a,b) => (b.data.pubDate ? new Date(b.data.pubDate).valueOf() : 0) - (a.data.pubDate ? new Date(a.data.pubDate).valueOf() : 0));
---

<Layout title="ZSEiU Łaziska Górne" description="Zespół Szkół Energetycznych i Usługowych w Łaziskach Górnych. Nowoczesna szkoła zawodowa z 80-letnią tradycją, kształcąca w kierunkach informatycznych, elektrycznych i logistycznych.">
  <div slot="hero">
    <Hero />
    <!-- Mobile fixed bottom bar -->
    <div class="mobile-bottom-bar">
      <a href="https://uonetplus.vulcan.net.pl/powiatmikolowski" target="_blank" rel="noopener noreferrer" class="mobile-bottom-bar__link" aria-label="E-Dziennik">
        <svg class="mobile-bottom-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5A2.5 2.5 0 016.5 17H20"/>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/>
          <path d="M8 7h8M8 11h6"/>
        </svg>
        <span>E-Dziennik</span>
      </a>
      <a href="/plan-lekcji" class="mobile-bottom-bar__link" aria-label="Plan lekcji">
        <svg class="mobile-bottom-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2"/>
          <path d="M16 2v4M8 2v4M3 10h18"/>
          <path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/>
        </svg>
        <span>Plan</span>
      </a>
      <a href="/dzwonki" class="mobile-bottom-bar__link" aria-label="Dzwonki">
        <svg class="mobile-bottom-bar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/>
        </svg>
        <span>Dzwonki</span>
      </a>
    </div>
  </div>

<div class="page-index">

    <WhyChooseSection />

    <!-- Kierunki kształcenia -->
    <section id="kierunki" class="reveal max-w-4xl mx-auto mb-16 scroll-mt-20 py-12">
      <h2 class="text-2xl font-bold text-center text-slate-900 dark:text-white mb-8">Nasze kierunki kształcenia</h2>
          <SchoolFields variant="detailed" />
    </section>

    <section id="mundurowe" class="reveal py-20 lg:py-28 bg-slate-50 dark:bg-navy-950">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
                <h2 class="text-xs font-bold text-primary-600 uppercase tracking-widest">Elitarny Profil Technikum nr 1</h2>
                <p class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">Technik Logistyk – Klasy mundurowe i&nbsp;Oddziały Przygotowania Wojskowego</p>
                <p class="text-lg text-slate-600 dark:text-slate-300">
                    Nasz autorski program łączy pełne kształcenie zawodowe technika logistyka z wszechstronnym przygotowaniem do pracy w formacjach mundurowych.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <div class="reveal bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-600 p-8 rounded-2xl shadow-sm hover:shadow-xl transition flex flex-col justify-between cursor-pointer">
                    <div class="space-y-4">
                        <div class="w-12 h-12 rounded-xl bg-slate-900 dark:bg-navy-700 text-white flex items-center justify-center">
                            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 dark:text-white">Przygotowanie do służby</h3>
                        <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed">
                            Zajęcia z zakresu funkcjonowania Policji, Straży Granicznej oraz innych formacji bezpieczeństwa publicznego. Poznasz procedury, prawo i etykę zawodową od podszewki.
                        </p>
                    </div>
                </div>

                <div class="reveal bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-600 p-8 rounded-2xl shadow-sm hover:shadow-xl transition flex flex-col justify-between cursor-pointer" style="transition-delay: 0.1s">
                    <div class="space-y-4">
                        <div class="w-12 h-12 rounded-xl bg-blue-600 text-white flex items-center justify-center">
                            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 dark:text-white">Taktyka i strzelectwo</h3>
                        <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed">
                            Obozy poligonowe, regularne ćwiczenia taktyczne, musztra oraz zaawansowane szkolenia na naszej nowoczesnej <strong>wirtualnej strzelnicy</strong> dostępnej w budynku szkoły.
                        </p>
                    </div>
                </div>

                <div class="reveal bg-white dark:bg-navy-800 border border-slate-200 dark:border-navy-600 p-8 rounded-2xl shadow-sm hover:shadow-xl transition flex flex-col justify-between cursor-pointer" style="transition-delay: 0.2s">
                    <div class="space-y-4">
                        <div class="w-12 h-12 rounded-xl bg-red-600 text-white flex items-center justify-center">
                            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 dark:text-white">Potęga Logistyki</h3>
                        <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed">
                            Zarządzanie łańcuchem dostaw, logistyka wojskowa i kryzysowa. Zdobywasz pełnoprawny tytuł Technika Logistyka, niezwykle pożądany również na cywilnym rynku pracy.
                        </p>
                    </div>
                </div>
            </div>

            <div class="mt-12 bg-slate-900 dark:bg-navy-700 text-white rounded-3xl p-8 lg:p-12 flex flex-col md:flex-row items-center justify-between gap-8">
                <div class="space-y-2">
                    <h4 class="text-xl font-bold">Unikalna szansa w regionie</h4>
                    <p class="text-slate-400 text-sm max-w-2xl">
                        Jesteśmy jedyną placówką w powiecie mikołowskim oferującą tak bogaty program klas mundurowych. Współpracujemy z lokalnymi komendami i jednostkami, dając Ci realną przewagę na starcie rekrutacji do służb mundurowych.
                    </p>
                </div>
                <a href="/kontakt" class="shrink-0 px-5 py-3 rounded-xl bg-white text-slate-900 font-bold hover:bg-slate-100 transition text-sm cursor-pointer">
                    Zapytaj o program zajęć
                </a>
            </div>

        </div>
    </section>

    <PartnersSection />

    <SuccessSection />

    <NewsSection posts={sortedPosts} />

    <!-- CTA -->
    <section class="reveal py-12 bg-primary-50 dark:bg-navy-800">
      <div class="container max-w-6xl text-center">
        <h2 class="text-2xl font-semibold">Zacznij swoją ścieżkę kariery</h2>
        <p class="mt-2 text-slate-700 dark:text-slate-300">Dołącz do szkoły, która łączy praktykę z realnymi partnerstwami branżowymi.</p>
        <div class="mt-4 flex justify-center gap-3">
          <a href="/rekrutacja" class="px-6 py-3 bg-primary-600 text-white rounded-md hover:bg-primary-700 transition cursor-pointer">Rekrutacja</a>
          <a href="/informacje" class="px-6 py-3 border border-gray-200 dark:border-navy-500 rounded-md text-slate-900 dark:text-white hover:bg-gray-50 dark:hover:bg-navy-700 transition cursor-pointer">Więcej informacji</a>
        </div>
      </div>
    </section>
</div>

<!-- high-contrast styles moved to src/styles/high-contrast.css -->
</Layout>
